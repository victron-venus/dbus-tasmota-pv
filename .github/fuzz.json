{
  "schema": 1,
  "language": "python",
  "setup": [
    [
      "python3",
      "-m",
      "venv",
      ".fuzz-venv"
    ],
    [
      ".fuzz-venv/bin/python",
      "-m",
      "pip",
      "install",
      "--require-hashes",
      "--only-binary=:all:",
      "-r",
      ".github/requirements-fuzz.txt"
    ]
  ],
  "targets": [
    {
      "name": "energy",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_energy.py",
        "-max_len=4096"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/energy",
      "instrumentation": [
        {
          "module": "dbus-tasmota-pv",
          "functions": [
            "parse_energy_payload",
            "_parse_energy_payload",
            "_energy_reading"
          ]
        }
      ]
    }
  ],
  "preflight-paths": [
    ".github/requirements-fuzz.in",
    "dbus-tasmota-pv.py",
    "fuzz",
    "pyproject.toml",
    "tasmota_settings.py",
    "uv.lock"
  ]
}
