{
  "validation_workflows": [
    "ci.yml",
    "release-security.yml",
    "codeql.yml",
    "dependency-review.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "bash scripts/ci.sh",
    "bash scripts/ci.sh security"
  ],
  "notes": [
    "Hardware-free checks do not validate a live Venus OS device, D-Bus firmware ABI, physical sensors or in-place device upgrades.",
    "Candidate overlays identify beta/nightly packages; RC packages retain the base version so stable promotes the exact verified bytes."
  ],
  "version_file": "version",
  "mode": "release",
  "repository": "victron-venus/dbus-tasmota-pv",
  "visibility": "public",
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "version",
        "format": "text",
        "value": "package",
        "prefix": "v"
      },
      {
        "path": "dbus-tasmota-pv.py",
        "format": "python",
        "value": "package",
        "field": "VERSION",
        "ecosystem": "pep440"
      },
      {
        "path": "pyproject.toml",
        "format": "toml",
        "field": "project.version",
        "package": "dbus-tasmota-pv",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "uv.lock",
        "format": "uv-lock",
        "package": "dbus-tasmota-pv",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "gitHubInfo",
        "format": "text",
        "value": "package",
        "prefix": "victron-venus:v"
      }
    ],
    "artifacts": [
      {
        "path": "dbus-tasmota-pv-*.tar.gz",
        "format": "tar-text",
        "value": "package",
        "member": "dbus-tasmota-pv/version",
        "prefix": "v"
      },
      {
        "path": "dbus-tasmota-pv-*.tar.gz",
        "format": "tar-toml",
        "value": "package",
        "member": "dbus-tasmota-pv/pyproject.toml",
        "field": "project.version",
        "package": "dbus-tasmota-pv",
        "ecosystem": "pep440"
      },
      {
        "path": "dbus-tasmota-pv-*.tar.gz",
        "format": "tar-text",
        "value": "package",
        "member": "dbus-tasmota-pv/gitHubInfo",
        "prefix": "victron-venus:v"
      }
    ],
    "toolkit_revision": "fca833a9da6b49116444ffd7ac6739e08f9cbc61"
  },
  "single_entry_ci": true
}
