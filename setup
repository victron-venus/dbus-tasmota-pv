#!/bin/bash

# dbus-tasmota-pv SetupHelper compatible setup script
# Tasmota power meter to Victron D-Bus PV inverter bridge

#### following line incorporates SetupHelper resources into this script
source "/data/SetupHelper/HelperResources/IncludeHelpers"
#### end of lines to include helper resources

#### running manually - prompt for input
if [ "$scriptAction" == 'NONE' ]; then
    standardActionPrompt
fi

#### install
if [ "$scriptAction" == 'INSTALL' ]; then
    logMessage "Installing $packageName"

    # Use the same persistent, inode-preserving service installation as the
    # direct CLI installer. Keep PackageManager bookkeeping in endScript.
    if ! sh "$scriptDir/install.sh"; then
        logMessage "Runtime installation failed"
        exit 1
    fi
fi

#### uninstall
if [ "$scriptAction" == 'UNINSTALL' ]; then
    logMessage "Uninstalling $packageName"

    # Remove Python scripts
    rm -rf /data/dbus-tasmota-pv
fi

# Services are installed explicitly above. INSTALL_SERVICE is not a valid
# SetupHelper flag (the generic helper accepts INSTALL_SERVICES, plural).
endScript
